[Unit]
Description=ChesHub battery levels for supported mice and keyboards
Documentation=https://github.com/cheesyserg/cheshub-plasma
After=systemd-udevd.service

[Service]
ExecStart=@BATTERYD_PATH@
Restart=on-failure
RestartSec=5

# Needs /dev/uhid (root-only) and the devices' hidraw nodes. No device
# allow-list: hidraw nodes come and go with hotplug.
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateNetwork=yes
NoNewPrivileges=yes
CapabilityBoundingSet=
RestrictAddressFamilies=AF_UNIX
RestrictNamespaces=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native

[Install]
WantedBy=multi-user.target
